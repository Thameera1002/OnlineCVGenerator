# Copy to .env.local and fill in. All values are public (embedded in the static site).

# Google AdSense publisher id, e.g. ca-pub-1234567890123456 (leave empty to disable ads)
NEXT_PUBLIC_ADSENSE_CLIENT=
# Ad unit slot id for the unit below the editor
NEXT_PUBLIC_ADSENSE_SLOT_EDITOR=

# Your buymeacoffee.com username (leave empty to hide the button)
NEXT_PUBLIC_BMC_USERNAME=
